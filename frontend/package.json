{
  "name": "nene-payout-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:widget",
    "build:widget": "vite build --config vite.widget.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && npm run lint:e2e",
    "lint:e2e": "cd .. && node frontend/node_modules/eslint/bin/eslint.js tests/e2e --max-warnings 0",
    "format": "prettier --check . ../tests/e2e --config .prettierrc.json",
    "format:fix": "prettier --write . ../tests/e2e --config .prettierrc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage && node tools/coverage-ratchet.mjs",
    "e2e": "NODE_PATH=./node_modules playwright test",
    "e2e:smoke": "npm run e2e -- --grep @smoke",
    "knip": "knip",
    "audit": "audit-ci --config audit-ci.jsonc",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run type-check && npm run lint && npm run format && npm run coverage:check && npm run knip && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@hideyukimori/nene2-client": "^1.4.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@hideyukimori/nene2-i18n": "^0.2.0",
    "@hideyukimori/nene2-standards": "^2.0.1",
    "@hideyukimori/nene2-tokens": "1.1.0",
    "@playwright/test": "^1.56.1",
    "@storybook/react-vite": "^10.5.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "audit-ci": "^7.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.2",
    "stylelint": "^16.26.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "brace-expansion@5": "^5.0.9",
    "brace-expansion@1": "^1.1.18",
    "undici": "^7.29.0",
    "fast-uri": "^3.1.5"
  }
}
